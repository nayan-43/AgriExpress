# --- Supabase Storage (S3-compatible) ---
# Project Settings → Storage → S3 Connection in your Supabase dashboard
# gives you the endpoint + access key/secret pair below.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_STORAGE_BUCKET=product-images
SUPABASE_STORAGE_KEY=your-s3-access-key-id
SUPABASE_STORAGE_SECRET=your-s3-secret-access-key
SUPABASE_STORAGE_REGION=ap-south-1
SUPABASE_STORAGE_ENDPOINT=https://YOUR_PROJECT_REF.supabase.co/storage/v1/s3

# Make the bucket "public" in Supabase (Storage → your bucket → Settings)
# so the generated URLs below are viewable without a signed request.
